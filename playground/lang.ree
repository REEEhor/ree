    // TODO: xd
};

val sayHi = fn(p: Person) {
    print("Hello, I am ", p.name, " and I am ", p.age, " years old.\n");
};

val setAge = fn(p_ptr: ^Person, new_age: i16) {
    // We allow an implicit deref here
    p_ptr.age += 1;
    // So that we don't have to do this:
    p_ptr^.age += 1;
    // ...although it doesn't look that bad...

    // Anyway, here's the actual code for this `setAge` function.
    p_ptr.age = new_age;
}

val MessageKind = enum {
    text,
    picture,
    friend_request,
};

val Message = union : enum {
    text: StringUtf8;
    picture: PictureData;
    friend_request: Person;
};

val StringUtf8 = struct {
    bytes: []u8;
};

val PictureData = struct {
